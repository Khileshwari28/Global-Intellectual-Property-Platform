<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Global IP Intelligence Platform</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
    body {
        font-family: Arial, sans-serif;
        background: #f4f6f8;
        margin: 0;
        padding: 20px;
    }

    h2 {
        text-align: center;
        color: #1f3c88;
    }

    .container {
        max-width: 1100px;
        margin: auto;
    }

    /* Search Form */
    .form-box {
        background: white;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 25px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 15px;
    }

    label {
        font-weight: bold;
        font-size: 14px;
    }

    input, select {
        width: 100%;
        padding: 9px;
        margin-top: 5px;
        border-radius: 5px;
        border: 1px solid #ccc;
    }

    button {
        margin-top: 15px;
        padding: 12px;
        width: 100%;
        background: #1f3c88;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
    }

    button:hover {
        background: #163172;
    }

    /* Filter Bar */
    .filter-bar {
        display: flex;
        gap: 15px;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }

    /* Table */
    table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

    th, td {
        padding: 10px;
        border: 1px solid #ddd;
        font-size: 14px;
        text-align:left;
    }

    th {
        background: #1f3c88;
        color: white;
    }

    tr:hover {
        background: #f1f1f1;
        cursor: pointer;
    }

    /* Pagination */
    .pagination {
        margin-top: 15px;
        text-align: center;
    }

    .pagination button {
        padding: 6px 12px;
        margin: 0 5px;
        background: #1f3c88;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }
</style>
</head>

<body>

<div class="container">
<h2>Patent & Trademark Search</h2>

<!-- 🔍 Search Form -->
<div class="form-box">
    <div class="form-grid">
        <div>
            <label>IP Type</label>
            <select id="ipType">
                <option value="">All</option>
                <option value="Patent">Patent</option>
                <option value="Trademark">Trademark</option>
            </select>
        </div>

        <div>
            <label>Keyword</label>
            <input type="text" id="keyword" placeholder="Artificial Intelligence">
        </div>

        <div>
            <label>Assignee / Owner</label>
            <input type="text" id="owner" placeholder="Google LLC">
        </div>

        <div>
            <label>Inventor</label>
            <input type="text" id="inventor" placeholder="John Doe">
        </div>

        <div>
            <label>Jurisdiction</label>
            <select id="jurisdiction">
                <option value="">All</option>
                <option value="India">India</option>
                <option value="United States">United States</option>
                <option value="European Union">European Union</option>
            </select>
        </div>
    </div>

    <button onclick="searchIP()">Search IP</button>
</div>

<!-- 📋 Search List -->
<div class="filter-bar">
    <select id="sortYear" onchange="applySort()">
        <option value="">Sort by Filing Year</option>
        <option value="new">Newest First</option>
        <option value="old">Oldest First</option>
    </select>
</div>

<table>
<thead>
<tr>
    <th>IP Type</th>
    <th>Application No</th>
    <th>Title</th>
    <th>Owner</th>
    <th>Inventor</th>
    <th>Jurisdiction</th>
    <th>Filing Year</th>
</tr>
</thead>
<tbody id="resultBody"></tbody>
</table>

<div class="pagination">
    <button onclick="prevPage()">Previous</button>
    <span id="pageInfo"></span>
    <button onclick="nextPage()">Next</button>
</div>
</div>

<script>
/* Mock IP Data */
const data = [
    { type: "Patent", appNo: "IN2024112345", title: "AI Medical Diagnosis", owner: "Infosys Ltd", inventor: "Ravi Kumar", country: "India", year: 2024 },
    { type: "Patent", appNo: "US2023019987", title: "Autonomous Vehicle System", owner: "Tesla Inc", inventor: "Elon Musk", country: "United States", year: 2023 },
    { type: "Trademark", appNo: "TM998877", title: "Android", owner: "Google LLC", inventor: "Google Inc", country: "United States", year: 2022 },
    { type: "Patent", appNo: "EP202099887", title: "Cloud Security Framework", owner: "IBM", inventor: "John Smith", country: "European Union", year: 2021 }
];

let filteredData = [];
let currentPage = 1;
const rowsPerPage = 2;

function searchIP() {
    const criteria = {
        ipType: ipType.value,
        keyword: keyword.value.toLowerCase(),
        owner: owner.value.toLowerCase(),
        inventor: inventor.value.toLowerCase(),
        jurisdiction: jurisdiction.value
    };

    filteredData = data.filter(d =>
        (!criteria.ipType || d.type === criteria.ipType) &&
        (!criteria.jurisdiction || d.country === criteria.jurisdiction) &&
        (!criteria.keyword || d.title.toLowerCase().includes(criteria.keyword)) &&
        (!criteria.owner || d.owner.toLowerCase().includes(criteria.owner)) &&
        (!criteria.inventor || d.inventor.toLowerCase().includes(criteria.inventor))
    );

    currentPage = 1;
    renderTable();
}

function renderTable() {
    const tbody = document.getElementById("resultBody");
    tbody.innerHTML = "";

    const start = (currentPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;

    filteredData.slice(start, end).forEach(item => {
        tbody.innerHTML += `
        <tr onclick="alert('IP Details Page – Next Milestone')">
            <td>${item.type}</td>
            <td>${item.appNo}</td>
            <td>${item.title}</td>
            <td>${item.owner}</td>
            <td>${item.inventor}</td>
            <td>${item.country}</td>
            <td>${item.year}</td>
        </tr>`;
    });

    pageInfo.innerText =
        filteredData.length
        ? `Page ${currentPage} of ${Math.ceil(filteredData.length / rowsPerPage)}`
        : "No results found";
}

function applySort() {
    const sort = sortYear.value;
    if (sort === "new") filteredData.sort((a, b) => b.year - a.year);
    if (sort === "old") filteredData.sort((a, b) => a.year - b.year);
    renderTable();
}

function nextPage() {
    if (currentPage * rowsPerPage < filteredData.length) {
        currentPage++;
        renderTable();
    }
}

function prevPage() {
    if (currentPage > 1) {
        currentPage--;
        renderTable();
    }
}
</script>

</body>
</html>
