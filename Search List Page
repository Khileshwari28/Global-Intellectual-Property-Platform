<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Search Results | IP Intelligence Platform</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            padding: 20px;
        }

        h2 {
            text-align: center;
            color: #1f3c88;
            margin-bottom: 20px;
        }

        /* Filter Bar */
        .filter-bar {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }

        select {
            padding: 8px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }

        /* Table */
        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

        th, td {
            padding: 10px;
            border: 1px solid #ddd;
            font-size: 14px;
            text-align: left;
        }

        th {
            background-color: #1f3c88;
            color: white;
        }

        tr:hover {
            background-color: #f1f1f1;
            cursor: pointer;
        }

        /* Pagination */
        .pagination {
            margin-top: 15px;
            text-align: center;
        }

        .pagination button {
            padding: 6px 12px;
            margin: 0 5px;
            background-color: #1f3c88;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        /* Responsive */
        @media (max-width: 768px) {
            table, thead, tbody, th, td, tr {
                display: block;
            }

            th {
                position: sticky;
                top: 0;
            }

            tr {
                margin-bottom: 15px;
            }

            td {
                border: none;
            }
        }
    </style>
</head>
<body>

<h2>Patent & Trademark Search Results</h2>

<!-- Filters same as Search Form -->
<div class="filter-bar">
    <select id="ipType" onchange="applyFilters()">
        <option value="">All IP Types</option>
        <option value="Patent">Patent</option>
        <option value="Trademark">Trademark</option>
    </select>

    <select id="jurisdiction" onchange="applyFilters()">
        <option value="">All Jurisdictions</option>
        <option>India</option>
        <option>United States</option>
        <option>European Union</option>
    </select>

    <select id="sortYear" onchange="applyFilters()">
        <option value="">Sort by Filing Year</option>
        <option value="new">Newest First</option>
        <option value="old">Oldest First</option>
    </select>
</div>

<!-- Result Table -->
<table>
    <thead>
        <tr>
            <th>IP Type</th>
            <th>Application No</th>
            <th>Title / Keyword</th>
            <th>Assignee / Owner</th>
            <th>Inventor</th>
            <th>Jurisdiction</th>
            <th>Filing Year</th>
        </tr>
    </thead>
    <tbody id="resultBody"></tbody>
</table>

<!-- Pagination -->
<div class="pagination">
    <button onclick="prevPage()">Previous</button>
    <span id="pageInfo"></span>
    <button onclick="nextPage()">Next</button>
</div>

<script>
    const data = [
        {
            type: "Patent",
            appNo: "IN2024112345",
            title: "AI Based Medical Diagnosis",
            owner: "Infosys Ltd",
            inventor: "Ravi Kumar",
            country: "India",
            year: 2024
        },
        {
            type: "Patent",
            appNo: "US2023019987",
            title: "Autonomous Vehicle Control",
            owner: "Tesla Inc",
            inventor: "Elon Musk",
            country: "United States",
            year: 2023
        },
        {
            type: "Trademark",
            appNo: "TM998877",
            title: "ChatGPT",
            owner: "OpenAI",
            inventor: "Sam Altman",
            country: "United States",
            year: 2022
        },
        {
            type: "Patent",
            appNo: "EP202099887",
            title: "Cloud Security Framework",
            owner: "IBM",
            inventor: "John Smith",
            country: "European Union",
            year: 2021
        }
    ];

    let currentPage = 1;
    const rowsPerPage = 2;
    let filteredData = [...data];

    function renderTable() {
        const tbody = document.getElementById("resultBody");
        tbody.innerHTML = "";

        const start = (currentPage - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        filteredData.slice(start, end).forEach(item => {
            const row = `
                <tr onclick="openDetails()">
                    <td>${item.type}</td>
                    <td>${item.appNo}</td>
                    <td>${item.title}</td>
                    <td>${item.owner}</td>
                    <td>${item.inventor}</td>
                    <td>${item.country}</td>
                    <td>${item.year}</td>
                </tr>`;
            tbody.innerHTML += row;
        });

        document.getElementById("pageInfo").innerText =
            `Page ${currentPage} of ${Math.ceil(filteredData.length / rowsPerPage)}`;
    }

    function applyFilters() {
        const type = document.getElementById("ipType").value;
        const country = document.getElementById("jurisdiction").value;
        const sort = document.getElementById("sortYear").value;

        filteredData = data.filter(d =>
            (type === "" || d.type === type) &&
            (country === "" || d.country === country)
        );

        if (sort === "new") {
            filteredData.sort((a, b) => b.year - a.year);
        } else if (sort === "old") {
            filteredData.sort((a, b) => a.year - b.year);
        }

        currentPage = 1;
        renderTable();
    }

    function nextPage() {
        if (currentPage * rowsPerPage < filteredData.length) {
            currentPage++;
            renderTable();
        }
    }

    function prevPage() {
        if (currentPage > 1) {
            currentPage--;
            renderTable();
        }
    }

    function openDetails() {
        alert("IP Details Page will open in next milestone");
        // window.location.href = "ip-details.html";
    }

    renderTable();
</script>

</body>
</html>
