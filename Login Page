<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login Page</title>

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f2f2f2;
    }

    /* 🔵 FULL-WIDTH BLUE HEADER */
    .top-bar {
        width: 100%;
        background: #0b63ce;
        padding: 85px 0;
        text-align: center;
        color: white;
        font-size: 22px;
        font-weight: bold;
    }

    /* Center login box */
    .container {
        display: flex;
        justify-content: center;
        margin-top: 40px;
    }

    .login-box {
        width: 360px;
        background:white;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0px 0px 10px rgba(0,0,0,0.2);
    }

    .login-box h2 {
        text-align: center;
        margin-bottom: 20px;
        color: #333;
    }

    input {
        width: 100%;
        padding: 12px;
        margin: 10px 0;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 15px;
    }

    .password-wrapper {
        position: relative;
    }

    .eye-icon {
        position: absolute;
        right: 12px;
        top: 14px;
        cursor: pointer;
        font-size: 18px;
        color: #444;
    }

    button {
        width: 100%;
        background: #0b63ce;
        padding: 12px;
        border: none;
        color: white;
        font-size: 16px;
        border-radius: 6px;
        cursor: pointer;
        margin-top: 10px;
    }

    button:hover {
        background: #084c9f;
    }

    .forgot {
        text-align: right;
        font-size: 14px;
        margin-top: 5px;
        cursor: pointer;
        color: #0b63ce;
    }

    /* Popup for Forget Password */
    .popup {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 350px;
        background: white;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0px 0px 15px rgba(0,0,0,0.3);
        text-align: center;
    }

    .popup input {
        width: 90%;
    }

    .popup button {
        width: 90%;
    }

</style>
</head>
<body>

<!-- 🔵 FULL SCREEN WIDTH HEADER -->
<div class="top-bar">
    Global IP Platform
</div>

<div class="container">
    <div class="login-box">
        <h2>Sign In to Your Account</h2>

        <label>Email Address</label>
        <input type="email" id="email" placeholder="Enter your email">

        <label>Password</label>
        <div class="password-wrapper">
            <input type="password" id="password" placeholder="Enter your password">
            <span class="eye-icon" onclick="togglePassword()">👁️</span>
        </div>

        <div class="forgot" onclick="openPopup()">Forgot Password?</div>

        <button onclick="login()">Login</button>
    </div>
</div>

<!-- POPUP FOR FORGET PASSWORD -->
<div class="popup" id="popupBox">
    <h3>Create New Password</h3>
    <input type="password" id="newPass" placeholder="Enter new password">
    <button onclick="savePassword()">Save Password</button>
    <button style="background:#777; margin-top:10px;" onclick="closePopup()">Close</button>
</div>

<script>
    // Default correct credentials
    let correctEmail = "kumardebanshu1908@gmail.com";
    let correctPassword = "12345";

    function login() {
        let email = document.getElementById("email").value;
        let password = document.getElementById("password").value;

        if (email === correctEmail && password === correctPassword) {
            alert("Login Successful!");
        } else {
            alert("Error! Incorrect Email or Password.");
        }
    }

    function togglePassword() {
        let pass = document.getElementById("password");
        pass.type = pass.type === "password" ? "text" : "password";
    }

    function openPopup() {
        document.getElementById("popupBox").style.display = "block";
    }

    function closePopup() {
        document.getElementById("popupBox").style.display = "none";
    }

    function savePassword() {
        let newPass = document.getElementById("newPass").value;

        if (newPass.trim() === "") {
            alert("Password cannot be empty!");
        } else {
            correctPassword = newPass;
            alert("Password Updated Successfully!");
            closePopup();
        }
    }
</script>

</body>
</html>
